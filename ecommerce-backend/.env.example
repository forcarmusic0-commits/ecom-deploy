# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (main e-commerce data)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# MySQL (chat data)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=ecommerce_chat
MYSQL_DATABASE=ecommerce_chat
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_ROOT_PASSWORD=yourpassword

# JWT
JWT_ACCESS_SECRET=access_secret_change_me_please
JWT_REFRESH_SECRET=refresh_secret_change_me_please
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
