# Copy this file to .env on the EC2 instance, then replace every placeholder.
PORT=5000
NODE_ENV=production
CLIENT_URL=https://ecom.work.gd
COOKIE_SECURE=true

# Docker Compose service names
MONGO_URI=mongodb://mongo:27017/ecommerce_db
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=ecommerce_chat
MYSQL_DATABASE=ecommerce_chat
MYSQL_USER=ecommerce
MYSQL_PASSWORD=REPLACE_WITH_STRONG_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_MYSQL_ROOT_PASSWORD

# Generate separate, long random values for these secrets.
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth is optional. Leave blank if Google login is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ecom.work.gd/api/auth/google/callback

# Required only when running `npm run seed:demo`.
DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
